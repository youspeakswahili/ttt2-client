#include <winver.h>
#include "../version.h"
1 ICON "client.ico"
1 24 "client.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION TTT2_CLIENT_VERSION_COMMAS
PRODUCTVERSION TTT2_CLIENT_VERSION_COMMAS
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "TTT2 Client"
      VALUE "ProductName", "TTT2 Client"
      VALUE "ProductVersion", TTT2_CLIENT_VERSION
      VALUE "FileVersion", TTT2_CLIENT_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
